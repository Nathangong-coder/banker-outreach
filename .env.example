# --- Apollo -------------------------------------------------------------
# One key, or several comma-separated. Extra keys are used when one is
# rate-limited, not to exceed any single account's terms.
APOLLO_API_KEYS=key_one,key_two

# --- Model provider -----------------------------------------------------
# LLM_PROVIDER: anthropic | openai | google | openrouter
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEYS=sk-ant-...
# OPENAI_API_KEYS=sk-...
# GOOGLE_API_KEYS=...
# OPENROUTER_API_KEYS=sk-or-...
# LLM_BASE_URL=            # only for proxies or self-hosted gateways

# --- Gmail --------------------------------------------------------------
# Get a refresh token with: python -m src.cli gmail-auth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- You ----------------------------------------------------------------
SENDER_NAME=
SENDER_EMAIL=
SENDER_BLURB=Third-year at UCLA studying business economics, focused on leveraged finance. Interned at a middle-market shop last summer.

# --- Volume -------------------------------------------------------------
DRAFTS_PER_DAY=12
ENRICH_BATCH=10
SEARCH_PER_BANK=25
MIN_AFFINITY=1
TARGET_TITLES=Managing Director,Vice President,Associate
TARGET_SENIORITIES=director,vp,senior,manager
